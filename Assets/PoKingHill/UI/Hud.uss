/* PoKingHill HUD theme. Panel units: 1080 x 1920 reference, scaled by screen height. One file for every border,
   radius, colour and type size so the menu, the sheets and the HUD look like one product. */

:root {
    --ink: rgb(244, 246, 250);
    --ink-dim: rgba(244, 246, 250, 0.62);
    --glass: rgba(14, 18, 26, 0.72);
    --glass-strong: rgba(10, 13, 20, 0.92);
    --line: rgba(255, 255, 255, 0.14);
    --accent: rgb(255, 196, 64);
    --accent-ink: rgb(26, 20, 6);
    --good: rgb(110, 214, 120);
    --bad: rgb(240, 96, 86);
    --radius: 22px;
    --gap: 16px;
}

.root { flex-grow: 1; flex-direction: row; justify-content: center; }
.column { height: 100%; overflow: hidden; }
.safe { flex-grow: 1; padding: 24px 28px 24px 28px; }

Label { color: var(--ink); -unity-font-style: normal; font-size: 34px; margin: 0; padding: 0; white-space: nowrap; }
.dim { color: var(--ink-dim); }
.shadow { text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.75); }

/* ---- corners ---------------------------------------------------------------------------------------------- */
.top-bar { flex-direction: row; align-items: center; justify-content: space-between; height: 92px; }
.top-center { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.title { font-size: 40px; -unity-font-style: bold; }
.pill { background-color: var(--glass); border-radius: 40px; padding: 8px 22px; font-size: 30px; border-width: 2px; border-color: var(--line); }
.fps { -unity-text-align: middle-center; }
.top-right { flex-direction: row; justify-content: flex-end; }
.bottom-bar { flex-direction: row; align-items: flex-end; justify-content: space-between; height: 84px; }
.version { font-size: 28px; color: var(--ink-dim); -unity-text-align: lower-right; }

.icon-btn { width: 84px; height: 84px; border-radius: 42px; background-color: var(--glass); border-width: 2px; border-color: var(--line); margin: 0; padding: 0; }
.icon-btn:hover { border-color: var(--accent); }
.icon-btn:active { background-color: var(--glass-strong); }
.icon { flex-grow: 1; }

/* ---- live strip ------------------------------------------------------------------------------------------- */
.scoreboard { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
.badge { flex-direction: row; align-items: center; background-color: var(--glass); border-radius: 30px; padding: 6px 16px 6px 10px; margin: 5px; border-width: 2px; border-color: var(--line); }
.badge.out { opacity: 0.45; }
.badge.you { border-color: var(--accent); }
.dot { width: 26px; height: 26px; border-radius: 13px; margin-right: 10px; }
.badge Label { font-size: 28px; }
.badge .wins { -unity-font-style: bold; margin-left: 10px; }

.round-info { flex-direction: row; align-items: center; justify-content: center; margin-top: 10px; }
.clock { font-size: 32px; -unity-font-style: bold; margin-right: 16px; }
.sea-bar { width: 320px; height: 16px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.15); overflow: hidden; }
.sea-fill { height: 100%; width: 0%; background-color: rgb(64, 156, 230); border-radius: 8px; }

.odds { flex-direction: row; height: 18px; margin: 14px 40px 0 40px; border-radius: 9px; overflow: hidden; background-color: rgba(255, 255, 255, 0.1); }
.odds-seg { height: 100%; }
.odds-label { font-size: 24px; -unity-text-align: middle-center; margin-top: 4px; }

.hazard-chip { align-self: center; margin-top: 12px; background-color: rgba(64, 140, 255, 0.85); border-radius: 30px; padding: 6px 22px; font-size: 28px; -unity-font-style: bold; }

.spacer { flex-grow: 1; }
.caption { align-self: center; font-size: 34px; -unity-font-style: bold; background-color: var(--glass); border-radius: 18px; padding: 10px 26px; margin-bottom: 14px; white-space: normal; max-width: 92%; -unity-text-align: middle-center; transition-property: opacity; transition-duration: 0.35s; }
.status { font-size: 26px; color: var(--ink-dim); flex-grow: 1; -unity-text-align: lower-center; margin: 0 16px 12px 16px; white-space: normal; }

/* ---- puppet stick ----------------------------------------------------------------------------------------- */
.puppet { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; }
.stick { width: 300px; height: 300px; border-radius: 150px; background-color: rgba(255, 255, 255, 0.10); border-width: 3px; border-color: var(--line); }
.stick-knob { position: absolute; width: 120px; height: 120px; border-radius: 60px; background-color: rgba(255, 196, 64, 0.85); left: 90px; top: 90px; }
.side-btns { flex-direction: row; }
.side-btn { width: 130px; height: 130px; border-radius: 65px; background-color: rgba(255, 255, 255, 0.12); border-width: 3px; border-color: var(--line); margin-left: 16px; font-size: 30px; color: var(--ink); }

/* ---- debug panel ------------------------------------------------------------------------------------------ */
.debug-panel { position: absolute; left: 28px; bottom: 128px; width: 640px; background-color: var(--glass-strong); border-radius: var(--radius); padding: 22px; border-width: 2px; border-color: var(--line); }
.debug-panel Label { font-size: 26px; white-space: normal; }
.debug-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }

/* ---- sheets (menu, results) ------------------------------------------------------------------------------- */
.scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.25); }
.sheet { position: absolute; left: 0; right: 0; bottom: 120px; background-color: var(--glass-strong); border-radius: 44px; padding: 22px 32px 28px 32px; border-width: 2px; border-color: var(--line); margin: 0 16px; }
.grabber { align-self: center; width: 120px; height: 10px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.25); margin-bottom: 18px; }
.tabs { flex-direction: row; background-color: rgba(255, 255, 255, 0.08); border-radius: 30px; padding: 6px; margin-bottom: 22px; }
.tab { flex-grow: 1; flex-basis: 0; height: 74px; border-radius: 26px; background-color: rgba(0, 0, 0, 0); border-width: 0; font-size: 32px; color: var(--ink-dim); margin: 0; }
.tab.selected { background-color: rgba(255, 255, 255, 0.16); color: var(--ink); -unity-font-style: bold; }
.h1 { font-size: 48px; -unity-font-style: bold; white-space: normal; }
.h2 { font-size: 30px; color: var(--ink-dim); margin: 18px 0 10px 4px; -unity-font-style: bold; }
.body { font-size: 28px; white-space: normal; color: var(--ink-dim); }

.primary { height: 108px; border-radius: 34px; background-color: var(--accent); color: var(--accent-ink); font-size: 42px; -unity-font-style: bold; border-width: 0; margin: 8px 0; }
.primary:hover { background-color: rgb(255, 210, 100); }
.secondary { height: 96px; border-radius: 30px; background-color: rgba(255, 255, 255, 0.10); color: var(--ink); font-size: 34px; border-width: 2px; border-color: var(--line); margin: 8px 0; flex-grow: 1; flex-basis: 0; }
.secondary:hover { border-color: var(--accent); }
.row { flex-direction: row; margin: 0 -7px; }
.row > .secondary { margin: 8px 7px; }

.seg { flex-direction: row; background-color: rgba(255, 255, 255, 0.08); border-radius: 24px; padding: 4px; margin: 4px 0 8px 0; }
.seg-btn { flex-grow: 1; flex-basis: 0; height: 64px; border-radius: 20px; border-width: 0; background-color: rgba(0, 0, 0, 0); color: var(--ink-dim); font-size: 28px; margin: 0; }
.seg-btn.selected { background-color: var(--accent); color: var(--accent-ink); -unity-font-style: bold; }

.grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.chip { width: 49%; flex-direction: row; align-items: center; justify-content: space-between; height: 76px; border-radius: 22px; background-color: rgba(255, 255, 255, 0.07); border-width: 2px; border-color: var(--line); padding: 0 18px; margin-bottom: 12px; }
.chip Label { font-size: 27px; white-space: normal; }
.chip .state { font-size: 26px; -unity-font-style: bold; color: var(--ink-dim); }
.chip.on { border-color: var(--accent); background-color: rgba(255, 196, 64, 0.14); }
.chip.on .state { color: var(--accent); }
.chip.locked { opacity: 0.45; }

.agent { width: 49%; height: 150px; border-radius: 26px; background-color: rgba(255, 255, 255, 0.07); border-width: 3px; border-color: var(--line); padding: 14px 18px; margin-bottom: 14px; }
.agent.on { border-color: var(--accent); background-color: rgba(255, 196, 64, 0.12); }
.agent.locked { opacity: 0.45; }
.agent .name { font-size: 31px; -unity-font-style: bold; white-space: normal; }
.agent .meta { font-size: 25px; color: var(--ink-dim); white-space: normal; }
.agent-top { flex-direction: row; align-items: center; }
.avatar { width: 54px; height: 54px; border-radius: 27px; margin-right: 14px; align-items: center; justify-content: center; }
.avatar Label { font-size: 26px; -unity-font-style: bold; color: var(--accent-ink); -unity-text-align: middle-center; }

.field { font-size: 28px; height: 70px; margin: 4px 0 8px 0; }
.field > .unity-text-field__input { background-color: rgba(255, 255, 255, 0.08); border-radius: 18px; border-color: var(--line); color: var(--ink); font-size: 28px; padding: 0 16px; }

/* results */
.winner-stripe { height: 12px; border-radius: 6px; margin: 12px 0 18px 0; }
.res-row { flex-direction: row; align-items: center; height: 64px; border-bottom-width: 1px; border-color: var(--line); }
.res-row Label { font-size: 27px; }
.res-name { flex-grow: 1; flex-basis: 0; }
.res-cell { width: 112px; -unity-text-align: middle-right; color: var(--ink-dim); }
.res-head Label { color: var(--ink-dim); font-size: 23px; }
.win { color: var(--good); -unity-font-style: bold; }
.loss { color: var(--bad); }
.bracket { margin-top: 12px; }
.bracket Label { font-size: 26px; }
.res-cell.elo { width: 150px; }
.primary.next { flex-grow: 1; flex-basis: 0; height: 96px; margin: 8px 7px; font-size: 36px; }
